{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kusano-tf.github.io/molkky-fun/app-data.schema.json",
  "title": "Mölkky Fun 保存データ",
  "description": "現在のアプリが保存・書き出す試合・セット形式。端末設定は含めません。旧形式の読み込みと変換はアプリで行います。順序の完全性、得点とピンの一致、確定状態、セット先取後の追加禁止、終了済み履歴はアプリで検証します。",
  "$defs": {
    "player": {
      "title": "プレイヤー",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "試合内で一意のID。同じ人物のIDを試合間で維持すると個人成績を通算できます。UUID形式に限定しません。"
        },
        "name": {
          "type": "string",
          "pattern": "\\S",
          "description": "表示名。空文字・空白のみは不可。同じ名前でもIDが異なると別プレイヤーです。"
        },
        "teamId": {
          "type": "string",
          "description": "所属チームのID。チーム戦では必須で、同じ試合のteams内に存在する必要があります。個人戦では使用しません。"
        }
      },
      "additionalProperties": true
    },
    "team": {
      "title": "チーム",
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "試合内で一意のチームID。プレイヤーIDとも重複できません。"
        },
        "name": {
          "type": "string",
          "pattern": "\\S",
          "description": "チームの表示名。空文字・空白のみは不可。"
        }
      },
      "additionalProperties": true
    },
    "throwRecord": {
      "title": "投球記録",
      "type": "object",
      "required": [
        "playerId",
        "points",
        "playedAt"
      ],
      "properties": {
        "playerId": {
          "type": "string",
          "minLength": 1,
          "description": "投げたプレイヤーのID。同じ試合のplayers内に存在し、その時点の投球順と一致する必要があります。"
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true,
          "maxItems": 12,
          "description": "倒れたピンの番号。空配列はミス、1要素なら番号が得点、複数要素なら本数が得点です。狙ったピンではありません。",
          "examples": [
            [],
            [
              12
            ],
            [
              2,
              5,
              9
            ]
          ]
        },
        "playedAt": {
          "type": "string",
          "description": "投球を記録した日時。新規記録はISO 8601形式（例：2026-11-13T03:00:00.000Z）。"
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "投球の得点（0はミス）。pinsもある場合はその得点と一致する必要があり、アプリで検証します。"
        }
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "required": [
        "winsRequired",
        "inputMode"
      ],
      "properties": {
        "winsRequired": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "inputMode": {
          "enum": [
            "simple",
            "detailed"
          ]
        }
      },
      "description": "試合開始時のルール設定。端末の現在設定は共有データと別のストレージキーで管理します。"
    },
    "matchSet": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "teamOrder",
        "playerOrder",
        "turns",
        "confirmed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "ruleVersion": {
          "const": 2,
          "description": "省略は旧ルールを維持する移行済みセット。"
        },
        "confirmed": {
          "type": "boolean",
          "description": "セット終了後、入力内容を確認して確定したか。未確定なら最終投球を取り消せます。"
        },
        "playerOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "teamOrder": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "turns": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/throwRecord"
              },
              {
                "required": [
                  "points"
                ]
              }
            ]
          }
        }
      }
    },
    "match": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "mode",
        "settings",
        "players",
        "teams",
        "sets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "individual",
            "team"
          ]
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "players": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/player"
          }
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/team"
          }
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matchSet"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "team"
              }
            }
          },
          "then": {
            "properties": {
              "teams": {
                "minItems": 2
              },
              "players": {
                "items": {
                  "required": [
                    "teamId"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "teams": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "settings": {
                "properties": {
                  "inputMode": {
                    "const": "simple"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "sets": {
                "items": {
                  "properties": {
                    "turns": {
                      "items": {
                        "not": {
                          "required": [
                            "pins"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "sets": {
                "items": {
                  "properties": {
                    "turns": {
                      "items": {
                        "required": [
                          "pins"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "matchData": {
      "type": "object",
      "required": [
        "version",
        "currentMatch",
        "history"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "currentMatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/match"
            },
            {
              "type": "null"
            }
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "version": 1,
      "currentMatch": null,
      "history": []
    },
    {
      "version": 1,
      "currentMatch": {
        "id": "example-match",
        "startedAt": "2026-11-17T00:00:00.000Z",
        "mode": "individual",
        "settings": {
          "winsRequired": 2,
          "inputMode": "simple"
        },
        "players": [
          {
            "id": "alice",
            "name": "Alice"
          },
          {
            "id": "bob",
            "name": "Bob"
          }
        ],
        "teams": [],
        "sets": [
          {
            "id": "set-1",
            "startedAt": "2026-11-17T00:00:00.000Z",
            "ruleVersion": 2,
            "confirmed": false,
            "playerOrder": [
              "alice",
              "bob"
            ],
            "teamOrder": [],
            "turns": [
              {
                "playerId": "alice",
                "points": 12,
                "playedAt": "2026-11-17T00:01:00.000Z"
              }
            ]
          }
        ]
      },
      "history": []
    },
    {
      "version": 1,
      "currentMatch": {
        "id": "example-team-match",
        "startedAt": "2026-11-17T00:00:00.000Z",
        "mode": "team",
        "settings": {
          "winsRequired": 2,
          "inputMode": "detailed"
        },
        "players": [
          {
            "id": "alice",
            "name": "Alice",
            "teamId": "red"
          },
          {
            "id": "bob",
            "name": "Bob",
            "teamId": "blue"
          }
        ],
        "teams": [
          {
            "id": "red",
            "name": "Red"
          },
          {
            "id": "blue",
            "name": "Blue"
          }
        ],
        "sets": [
          {
            "id": "set-1",
            "startedAt": "2026-11-17T00:00:00.000Z",
            "ruleVersion": 2,
            "confirmed": false,
            "playerOrder": [
              "alice",
              "bob"
            ],
            "teamOrder": [
              "red",
              "blue"
            ],
            "turns": [
              {
                "playerId": "alice",
                "points": 12,
                "playedAt": "2026-11-17T00:01:00.000Z",
                "pins": [
                  12
                ]
              }
            ]
          }
        ]
      },
      "history": []
    }
  ],
  "$ref": "#/$defs/matchData"
}
